<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:context=".ui.classes.ClassListActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_none">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Conducto.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_classes"
            app:titleTextAppearance="@style/TextAppearance.Conducto.ToolbarTitle"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Filter + sort bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_base"
        android:gravity="end|center_vertical">

        <!-- Sort button -->
        <ImageButton
            android:id="@+id/sort_by_name_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_highlight"
            android:src="@drawable/ic_sort"
            android:tint="@color/white"
            android:contentDescription="@string/sort_by_name"
            android:padding="@dimen/spacing_sm"/>

        <!-- Filter button -->
        <ImageButton
            android:id="@+id/filter_by_user_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_circle_highlight"
            android:src="@drawable/ic_filter_list"
            android:tint="@color/white"
            android:contentDescription="@string/filter_my_classes"
            android:padding="@dimen/spacing_sm"/>

    </LinearLayout>

    <!-- Class list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/classes_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        tools:listitem="@layout/class_item"/>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_class_fab"
        style="@style/Widget.Conducto.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="@string/content_desc_add"
        android:layout_marginBottom="@dimen/fab_margin"
        android:layout_marginEnd="@dimen/fab_margin"/>

</LinearLayout>
