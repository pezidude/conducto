<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Main Live Lesson Content (TODO) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/live_available_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_live_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_main_content_todo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_enter_live"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_enter_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_join_lesson"
            app:layout_constraintTop_toBottomOf="@id/tv_live_todo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- No Live Lesson Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_live_lesson_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iv_no_live"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_music_note"
            app:tint="@color/navy_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.4"
            android:contentDescription="@string/content_desc_music_note" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/live_no_active_lesson"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/iv_no_live"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
