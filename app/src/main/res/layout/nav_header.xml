<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primary"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/screen_horizontal_margin"
    android:paddingTop="@dimen/spacing_2xl"
    android:paddingBottom="@dimen/spacing_lg">

    <!-- Avatar circle -->
    <FrameLayout
        android:layout_width="@dimen/avatar_size_lg"
        android:layout_height="@dimen/avatar_size_lg"
        android:background="@drawable/bg_avatar_circle">

        <TextView
            android:id="@+id/nav_avatar_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SC"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/nav_user_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/content_desc_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Conducto.Circle"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- User Info Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_md">

        <!-- Name -->
        <TextView
            android:id="@+id/nav_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            tools:text="Sarah Cohen"/>

        <!-- Email -->
        <TextView
            android:id="@+id/nav_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/navy_200"
            android:textSize="@dimen/text_body_sm"
            android:layout_marginTop="@dimen/spacing_xxs"
            tools:text="sarah@example.com"/>

        <!-- Role badge -->
        <TextView
            android:id="@+id/nav_user_status"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/badge_height"
            android:paddingStart="@dimen/badge_padding_horizontal"
            android:paddingEnd="@dimen/badge_padding_horizontal"
            android:gravity="center"
            android:background="@drawable/bg_badge_today"
            android:textColor="@color/badge_today_text"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="@dimen/spacing_sm"
            tools:text="Teacher"/>

    </LinearLayout>

</LinearLayout>
