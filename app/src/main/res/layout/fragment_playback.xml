<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:paddingStart="@dimen/screen_horizontal_margin"
    android:paddingEnd="@dimen/screen_horizontal_margin"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    tools:context=".ui.player.PlaybackFragment">

    <!-- Single Main Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Reset / skip back -->
        <ImageButton
            android:id="@+id/reset_button"
            android:layout_width="@dimen/playback_control_size"
            android:layout_height="@dimen/playback_control_size"
            android:background="@drawable/bg_card_rounded"
            android:src="@drawable/skip_previous_24px"
            android:contentDescription="@string/reset_playback"
            android:padding="@dimen/spacing_sm"
            android:scaleType="fitCenter"/>

        <!-- Play / Pause (primary) -->
        <FrameLayout
            android:layout_width="@dimen/playback_control_size_primary"
            android:layout_height="@dimen/playback_control_size_primary"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/bg_avatar_circle">

            <ImageButton
                android:id="@+id/play_pause_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:src="@drawable/play_pause_24px"
                android:contentDescription="@string/play_pause"
                android:padding="@dimen/spacing_md"/>

        </FrameLayout>

        <!-- Compact Speed slider in the row -->
        <com.google.android.material.slider.Slider
            android:id="@+id/speed_slider"
            style="@style/Widget.Conducto.SeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="50.0"
            android:valueTo="200.0"
            android:stepSize="25.0"
            android:value="100.0"
            app:labelBehavior="gone"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/progress_track"
            app:trackHeight="@dimen/progress_height"/>

    </LinearLayout>

    <!-- Progress bar under the main controls row -->
    <ProgressBar
        android:id="@+id/playback_progress_bar"
        style="@style/Widget.Conducto.ProgressBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="@dimen/spacing_xs"
        android:max="100"
        android:progress="38"
        android:progressDrawable="@drawable/bg_progress_bar"/>
</LinearLayout>
