<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Conducto.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
    android:layout_marginVertical="@dimen/card_margin_vertical"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_16"
        android:gravity="center_vertical">

        <!-- Icon tile with more character -->
        <FrameLayout
            android:layout_width="@dimen/list_item_icon_size"
            android:layout_height="@dimen/list_item_icon_size"
            android:background="@drawable/bg_icon_tile"
            android:backgroundTint="@color/navy_50">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lessons"
                android:contentDescription="@null"/>

        </FrameLayout>

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_16">

            <TextView
                android:id="@+id/class_title"
                style="@style/TextAppearance.Conducto.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                tools:text="Advanced Piano Composition"/>

            <TextView
                android:id="@+id/class_info"
                style="@style/TextAppearance.Conducto.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                tools:text="16 students · Mon &amp; Wed"/>

            <TextView
                android:id="@+id/class_teacher"
                style="@style/TextAppearance.Conducto.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/brand_accent"
                android:fontFamily="sans-serif-medium"
                tools:text="Mr. Cohen"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
