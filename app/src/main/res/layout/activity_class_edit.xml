<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:context=".ui.classes.ClassEditActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_none">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Conducto.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_edit"
            app:title="@string/title_edit_class"
            app:titleTextAppearance="@style/TextAppearance.Conducto.ToolbarTitle"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Class name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_class_name"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                android:hint="@string/hint_class_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/class_name_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textCapWords"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_class_description"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginTop="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                android:hint="@string/hint_class_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/class_description_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Join code (shown for existing classes) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Conducto.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_base"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join code"
                        style="@style/TextAppearance.Conducto.BodySmall"
                        android:layout_marginEnd="@dimen/spacing_sm"/>

                    <TextView
                        android:id="@+id/join_code_text_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        tools:text="AB12CD"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_class_button"
                style="@style/Widget.Conducto.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_save_class"
                android:layout_marginTop="@dimen/spacing_xl"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
