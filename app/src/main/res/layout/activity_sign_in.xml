<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header (navy) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- Brand mark -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_music_note"
                    android:contentDescription="@null"
                    android:tint="@color/accent"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_headline"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.015"
                android:layout_marginTop="@dimen/spacing_base"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_subtitle"
                android:textColor="@color/navy_200"
                android:textSize="@dimen/text_body_sm"
                android:layout_marginTop="@dimen/spacing_xs"/>

        </LinearLayout>

        <!-- Form body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Email field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_email"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                app:startIconDrawable="@drawable/ic_music_note"
                app:startIconTint="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_password"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginTop="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_forgot_password"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/text_body_sm"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"/>

            <!-- Error message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/error"
                android:textSize="@dimen/text_body_sm"
                android:background="@color/error_container"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                android:layout_marginTop="@dimen/spacing_base"/>

            <!-- Sign In button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                style="@style/Widget.Conducto.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_sign_in"
                android:layout_marginTop="@dimen/spacing_lg"/>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_lg">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/divider_height"
                    android:layout_weight="1"
                    android:background="@color/divider"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/divider_height"
                    android:layout_weight="1"
                    android:background="@color/divider"/>

            </LinearLayout>

            <!-- Sign up link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_base">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_no_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_sm"/>

                <TextView
                    android:id="@+id/tvGoToSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_go_sign_up"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_body_sm"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/spacing_xs"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
