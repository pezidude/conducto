<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:context=".ui.TestActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_none">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Conducto.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Sheet Music"
            app:titleTextAppearance="@style/TextAppearance.Conducto.ToolbarTitle"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- File picker tap area -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectFile"
                style="@style/Widget.Conducto.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xl">

                    <ImageView
                        android:id="@+id/ivFileIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_upload_file"
                        android:tint="@color/accent"
                        android:contentDescription="@null"/>

                    <TextView
                        android:id="@+id/tvSelectFile"
                        style="@style/TextAppearance.Conducto.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open sheet music"
                        android:layout_marginTop="@dimen/spacing_md"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a MusicXML file from your device"
                        style="@style/TextAppearance.Conducto.BodySmall"
                        android:layout_marginTop="@dimen/spacing_xxs"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Selected file info card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/test_actions_card"
                style="@style/Widget.Conducto.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Selected filename -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/surface_input"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_music_note"
                            android:tint="@color/text_hint"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/tvFilename"
                            style="@style/TextAppearance.Conducto.BodySmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="No file selected"
                            android:maxLines="1"
                            android:ellipsize="middle"/>

                    </LinearLayout>

                    <!-- View button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewSheetMusic"
                        style="@style/Widget.Conducto.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="View sheet music"
                        android:enabled="false"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:icon="@drawable/ic_play"
                        app:iconTint="@color/white"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
