<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    tools:context=".ui.lessons.LessonEditActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_none">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Conducto.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_edit"
            app:title="@string/title_edit_lesson"
            app:titleTextAppearance="@style/TextAppearance.Conducto.ToolbarTitle"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loading_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Lesson title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_lesson_title"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                android:hint="@string/hint_lesson_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lesson_title_input"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lesson notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_lesson_notes"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginTop="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput"
                android:hint="@string/hint_lesson_notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lesson_info_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Genre Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre"
                style="@style/TextAppearance.Conducto.Label"
                android:layout_marginTop="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Conducto.TextInput.ExposedDropdownMenu"
                android:hint="Select Genre">

                <AutoCompleteTextView
                    android:id="@+id/genre_autocomplete"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:popupBackground="@color/background_surface"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date & time section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_lesson_date"
                    style="@style/TextAppearance.Conducto.Label"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <TextView
                    android:id="@+id/date_text_view"
                    style="@style/TextAppearance.Conducto.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"/>
                
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time:"
                    style="@style/TextAppearance.Conducto.Label"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <TextView
                    android:id="@+id/time_text_view"
                    style="@style/TextAppearance.Conducto.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <ImageButton
                    android:id="@+id/lesson_date_time_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Select Date and Time"/>
            </LinearLayout>

            <!-- Upload MusicXML -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/upload_music_xml_button"
                style="@style/Widget.Conducto.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/content_desc_upload_file"
                app:icon="@drawable/ic_upload_file"
                app:iconTint="@color/text_primary"
                android:layout_marginTop="@dimen/spacing_base"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_group_voices_picker"
                style="@style/Widget.Conducto.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Group Voices &amp; Upload"
                app:icon="@drawable/ic_brush"
                app:iconTint="@color/text_primary"
                android:layout_marginTop="@dimen/spacing_sm"/>

            <!-- Error message view -->
            <TextView
                android:id="@+id/error_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_xs"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Error message goes here"/>

            <!-- Music XML list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/music_xml_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"/>

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_lesson_button"
                style="@style/Widget.Conducto.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_create_save_lesson"
                android:layout_marginTop="@dimen/spacing_lg"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
