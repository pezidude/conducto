<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_card_rounded.xml
     White surface with border — used as background for non-MaterialCard views -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/background_surface" />

    <stroke
        android:width="@dimen/card_stroke_width"
        android:color="@color/border_default" />

    <corners android:radius="@dimen/radius_card" />

</shape>
